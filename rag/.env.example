
# Copy to .env in the rag/ folder and fill in. .env is git-ignored; never commit real keys.

# --- LLM (needed for answering questions; NOT needed for ingestion) ---
LLM_PROVIDER=groq
GROQ_API_KEY=PASTE_YOUR_NEW_KEY_HERE
GROQ_MODEL=openai/gpt-oss-120b
# GROQ_MODEL=llama-3.3-70b-versatile
LLM_MAX_TOKENS=1500
LLM_TIMEOUT_S=60
# Only if LLM_PROVIDER=anthropic:
# ANTHROPIC_API_KEY=PASTE_YOUR_KEY_HERE
# ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Storage (relative paths are resolved against the rag/ folder) ---
RAG_DOCUMENTS_DIR=documents
RAG_CHROMA_DIR=chroma_db
RAG_COLLECTION_NAME=project_documents_minilm

# --- Project ids: documents/<type-folder>/<project-folder>/file => level 2 ---
RAG_PROJECT_FOLDER_LEVEL=2

# --- Embeddings (local sentence-transformers; no API key) ---
RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_EMBEDDING_BATCH_SIZE=64
# Device is left unset = auto-detect (uses cuda/mps if available, else CPU).
# RAG_EMBEDDING_DEVICE=cpu
# Query prefix is left unset: MiniLM needs none (BGE models get theirs automatically).
# RAG_EMBEDDING_QUERY_PREFIX=

# --- Chunking (approximate tokens) ---
RAG_CHUNK_SIZE_TOKENS=250
RAG_CHUNK_OVERLAP_TOKENS=40
RAG_CSV_OVERLAP_ROWS=0

# --- Retrieval ---
RAG_TOP_K=5
# RAG_MAX_DISTANCE=
RAG_MAX_CONTEXT_TOKENS=6000


# --- Append these lines to your existing rag/.env (all optional; the values shown are the defaults) ---

# Skip parsing files whose SHA-256 is unchanged since the last run (set false to always re-parse).
RAG_USE_MANIFEST=true

# Processes used to parse + chunk NEW/CHANGED files. 1 = no multiprocessing (safest).
# Try 2-4 only if the benchmark shows PDF loading dominates. Keep it below your CPU core count.
RAG_LOAD_WORKERS=1

# Chunks (from many documents) collected before one embedding call + one database write.
RAG_EMBED_FLUSH_CHUNKS=256

# Existing variable, worth tuning with the benchmark (--embed-sample 200 --batch-sizes 16 32 64):
# RAG_EMBEDDING_BATCH_SIZE=32


# Turned off for the first MiniLM run so old BGE vectors cached by text can never be reused.
# Turn back on only after checking that src/embedding_cache.py keys vectors by model name.
RAG_EMBEDDING_CACHE=false
